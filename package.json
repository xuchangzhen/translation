{
  "name": "translation",
  "version": "0.5.6",
  "private": true,
  "description": "跨平台全局划词与截图翻译工具",
  "main": "src/main.cjs",
  "author": "翻译项目贡献者",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "build:renderer": "vite build",
    "build": "pnpm typecheck && pnpm test && pnpm build:renderer && electron-builder --publish never",
    "build:mac": "pnpm typecheck && pnpm test && pnpm build:renderer && electron-builder --mac --arm64 --publish never",
    "build:win": "pnpm typecheck && pnpm test && pnpm build:renderer && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "electron-updater": "^6.8.9",
    "phonemize": "2.0.0",
    "tesseract.js": "^6.0.1",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.linguabridge.desktop",
    "productName": "翻译",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/uiohook-napi/**",
      "node_modules/node-gyp-build/**"
    ],
    "files": [
      "dist/**/*",
      "src/main.cjs",
      "src/preload.cjs",
      "src/lib/**/*",
      "package.json",
      "!node_modules/uiohook-napi/build/**"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xuchangzhen",
        "repo": "translation"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "translation-${version}-${arch}-mac.${ext}",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "翻译使用系统语音播放译文，不会录制麦克风。",
        "NSScreenCaptureUsageDescription": "翻译需要屏幕录制权限以进行截图 OCR 翻译。"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "translation-setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "translation-portable-${version}-${arch}.${ext}"
    }
  }
}
